# ---- 构建产物 / 依赖（都可以重新生成，不进仓库）----
node_modules/
public/
.deploy_git/
db.json
db.json.*

# ---- Hexo 运行时 ----
.hexo/
*.log

# ---- 主题原图备份、临时文件 ----
_theme_backup/
*.bak
*.tmp
*.orig

# ---- 音频 ----
# cola 主题自带两个 mp3（kabuda.mp3 是有版权的特摄原声，
# 八连杀.mp3 是低俗网络歌曲），不进仓库、也不发布到 Pages。
# 构建时由 scripts/clean-publish.js 按文件名精确删除。
#
# ⚠️ 注意：这里不能写 *.mp3 —— 博客自己的音乐（音乐播放器用的）就放在
#    themes/cola/source/music/ 下，需要一起提交和部署。
themes/cola/source/music/kabuda.mp3
themes/cola/source/music/八连杀.mp3
*.flac
*.wav
*.m4a

# ---- 系统垃圾 ----
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 便捷编辑工具产生的运行时数据 ----
blog-editor/.venv/
blog-editor/__pycache__/
blog-editor/.cache/
__pycache__/
*.pyc
