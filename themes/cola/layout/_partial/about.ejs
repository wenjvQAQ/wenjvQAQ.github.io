<link rel="stylesheet" href="<%- url_for('css/partial/about.css') %>" />

<%
  // likes 里用 [[文字](链接)] 表示超链接。
  // 先整体转义，再把标记替换成 <a>，避免配置里的尖括号被当成 HTML 注入。
  function renderLike(item) {
    const esc = String(item)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    return esc.replace(/\[\[([^\]]+)\]\(([^)]+)\)\]/g, function (_, text, url) {
      // 只放行 http/https，挡掉 javascript: 之类的伪协议
      if (!/^https?:\/\//i.test(url)) return text
      return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + text + '</a>'
    })
  }
%>
<div class="about">
  <div class="about-top">
    <div class="about-title">
      <h2>关于我</h2>
    </div>
    <div class="about-info">
      <img class="about-avatar" src="<%- url_for('/imgs/avatar.jpg') %>" alt="">
      <div class="about-detail">
        <% theme.likes.forEach(item => { %>
          <p><%- renderLike(item) %></p>
        <% })%>
      </div>
    </div>
  </div>
  <div class="about-content">
    <%- page.content %>
  </div>
</div>
